jenkins:
  controller:
    JCasC:
      securityRealm: |-
        local:
          allowsSignup: true
          enableCaptcha: false
          users:
          - id: "${chart-admin-username}"
            name: "Hemanth"
            password: "${chart-admin-password}"
          - id: "readuser"
            name: "Read User"
            password: "readuser"
